# FlowSync Frontend Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real credentials

# API Gateway base URL (defaults to production if not set)
NEXT_PUBLIC_API_BASE_URL=https://86tzell2w9.execute-api.us-east-1.amazonaws.com/prod

# Demo project credentials (optional — for evaluators/judges)
# Set these in your deployment environment, NOT in this file
# NEXT_PUBLIC_DEMO_PROJECT_ID=your-demo-project-id
# NEXT_PUBLIC_DEMO_TOKEN=your-demo-token

# Enable mock data for development (optional)
# NEXT_PUBLIC_USE_MOCK=true