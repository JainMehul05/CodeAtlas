# FlowSync MCP Server Configuration
# Copy to .env and fill in your values
# NEVER commit .env or any file with real credentials

# API Gateway base URL (no trailing slash)
FLOWSYNC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Default project ID (used when tool caller omits it)
FLOWSYNC_PROJECT_ID=

# Bearer token for authenticated endpoints (GET /events, POST /query)
FLOWSYNC_TOKEN=

# Optional: Git branch override (defaults to current branch from git)
# FLOWSYNC_BRANCH=main