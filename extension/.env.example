# FlowSync VS Code Extension Configuration
# This file is for reference only — the extension reads settings from VS Code configuration

# Backend API URL (defaults to production if not set)
# FLOWSYNC_BACKEND_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Dashboard URL (defaults to production if not set)
# FLOWSYNC_DASHBOARD_URL=https://your-dashboard.example.com